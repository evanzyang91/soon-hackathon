# Copy to .env.local (gitignored; .env also works). Server-only; never prefix with VITE_.
WLT_API_KEY=            # World Labs Marble — https://platform.worldlabs.ai/api-keys
ANTHROPIC_API_KEY=      # screenplay → scene plan
OPENAI_API_KEY=         # character reference images + TTS
# ELEVENLABS_API_KEY=   # optional, preferred for TTS when set
MODAL_TOKEN_ID=         # Orbis LHM avatar stage (or `modal token set` in the shell)
MODAL_TOKEN_SECRET=
# HIGGSFIELD_API_KEY=   # optional: generated video as a world / performance source
MOCK=0                  # 1 = no network: fixture world/actors/audio, used by tests
PORT=5173
MARBLE_MODEL=marble-1.1 # marble-1.0-draft for faster, cheaper previews
