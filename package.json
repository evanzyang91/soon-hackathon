{
  "name": "previz-stage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Screenplay to walkable Marble scenes you can film with your phone",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@sparkjsdev/spark": "^2.4.0",
    "dotenv": "^17.2.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": { "node": ">=22" },
  "prettier": { "singleQuote": true, "printWidth": 100, "tabWidth": 2 }
}
